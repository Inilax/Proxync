// This is your Prisma schema file
// Learn more about it at: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ──────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  tunnels        Tunnel[]
  messages       Message[]
  voiceParticipants VoiceParticipant[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Workspaces ─────────────────────────────────────────────────

model Workspace {
  id                String   @id @default(uuid())
  name              String
  ownerId           String
  plan              String   @default("beta")
  bandwidthUsedGB   Float    @default(0)
  bandwidthLimitGB  Float    @default(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  memberships      Membership[]
  apiKeys          ApiKey[]
  tunnels          Tunnel[]
  channels         Channel[]
  bandwidthUsages  BandwidthUsage[]
  inviteTokens     InviteToken[]
  domains          Domain[]

  @@map("workspaces")
}

model Membership {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ─── API Keys ───────────────────────────────────────────────────

model ApiKey {
  id           String    @id @default(uuid())
  workspaceId  String
  name         String
  keyPrefix    String    // e.g. "opk_abc123" — shown in list view
  hashedSecret String    // bcrypt hash of the full key
  scopes       String[]  @default([])
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([keyPrefix])
  @@map("api_keys")
}

// ─── Tunnels ────────────────────────────────────────────────────

model Tunnel {
  id           String       @id @default(uuid())
  workspaceId  String
  ownerId      String
  localPort    Int
  protocol     String       @default("http")
  publicUrl    String       @unique
  subdomain    String       @unique
  region       String       @default("auto")
  status       TunnelStatus @default(ACTIVE)
  passwordHash String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  closedAt     DateTime?

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner           User             @relation(fields: [ownerId], references: [id])
  requestLogs     RequestLog[]
  bandwidthUsages BandwidthUsage[]

  @@index([workspaceId])
  @@index([ownerId])
  @@index([status])
  @@map("tunnels")
}

enum TunnelStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

// ─── Request Inspector ──────────────────────────────────────────

model RequestLog {
  id          String   @id @default(uuid())
  tunnelId    String
  method      String
  path        String
  status      Int?
  headers     Json     @default("{}")
  bodyPreview String?  @db.Text
  durationMs  Int?
  capturedAt  DateTime @default(now())

  tunnel Tunnel @relation(fields: [tunnelId], references: [id], onDelete: Cascade)

  @@index([tunnelId])
  @@index([capturedAt])
  @@map("request_logs")
}

// ─── Channels & Messages ─────────────────────────────────────────

model Channel {
  id          String      @id @default(uuid())
  workspaceId String
  name        String
  type        ChannelType @default(TEXT)
  createdAt   DateTime    @default(now())

  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages          Message[]
  voiceParticipants VoiceParticipant[]

  @@index([workspaceId])
  @@map("channels")
}

enum ChannelType {
  TEXT
  VOICE
}

model Message {
  id            String      @id @default(uuid())
  channelId     String
  userId        String
  text          String      @db.Text
  screenshotUrl String?
  kind          MessageKind @default(CHAT)
  resolved      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([channelId])
  @@map("messages")
}

enum MessageKind {
  CHAT
  FEEDBACK
}

model VoiceParticipant {
  id        String   @id @default(uuid())
  channelId String
  userId    String
  joinedAt  DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([channelId, userId])
  @@map("voice_participants")
}

// ─── Bandwidth ──────────────────────────────────────────────────

model BandwidthUsage {
  id          String   @id @default(uuid())
  workspaceId String
  tunnelId    String
  bytesIn     BigInt   @default(0)
  bytesOut    BigInt   @default(0)
  recordedAt  DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tunnel    Tunnel    @relation(fields: [tunnelId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([tunnelId])
  @@map("bandwidth_usages")
}

// ─── Invites ────────────────────────────────────────────────────

model InviteToken {
  id          String   @id @default(uuid())
  workspaceId String
  email       String
  role        Role     @default(MEMBER)
  token       String   @unique @default(uuid())
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([token])
  @@map("invite_tokens")
}

// ─── Custom Domains ─────────────────────────────────────────────

model Domain {
  id                String    @id @default(uuid())
  workspaceId       String
  name              String    @unique
  verificationToken String
  verified          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("domains")
}
