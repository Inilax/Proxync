{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proxync",
  "version": "0.2.1",
  "identifier": "com.proxync.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Proxync",
        "width": 800,
        "height": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' ws: wss: http: https: ipc:;"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Inilax",
    "copyright": "Copyright © 2026 Inilax",
    "shortDescription": "Developer Tunneling Workspace Studio",
    "longDescription": "Proxync — Developer Tunneling Workspace Studio",
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Inilax/Proxync/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3MTlEODBGOUQ4OUU2NkMKUldSczVvbWREOWdaRjlEaGthd2d5czRRVEpHNWxnVmMzbDNndm9VZEplVis4dTR0ZlJ0M3FtWTAK"
    }
  }
}