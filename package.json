{
  "name": "proxync",
  "private": true,
  "version": "0.0.1",
  "description": "Proxync — instant tunnel + collaboration workspace",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=packages/api",
    "dev:desktop": "npm run tauri:dev --workspace=packages/desktop",
    "build:api": "npm run build --workspace=packages/api",
    "test:api": "npm run test --workspace=packages/api"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
