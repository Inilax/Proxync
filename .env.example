# ─── Database ───────────────────────────────────────────────────
DATABASE_URL="postgresql://proxync:proxync_dev@localhost:5432/proxync?schema=public"

# ─── Redis ──────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT ────────────────────────────────────────────────────────
JWT_SECRET="change_me_in_production_at_least_32_chars"
JWT_REFRESH_SECRET="change_me_refresh_at_least_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── App ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Relay ──────────────────────────────────────────────────────
RELAY_HOST="localhost"
RELAY_PORT=3001
RELAY_SUBDOMAIN_BASE="localtest.me"

# ─── API Keys ───────────────────────────────────────────────────
API_KEY_PREFIX="opk_"
